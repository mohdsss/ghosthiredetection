# GhostHire Environment Configuration

# AWS Credentials (Optional for local testing - mock service activates if unset)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=ghosthire-screenshots-storage

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=GhostHireReports

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
